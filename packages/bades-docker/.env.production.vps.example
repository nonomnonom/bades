# Template .env produksi VPS — full Docker (db + redis + app) + Caddy TLS.
# Copy ke repo root: cp packages/bades-docker/.env.production.vps.example .env
# Jangan commit file .env asli setelah diisi secret.

# ── Image produksi ──
BADES_IMAGE=ghcr.io/nonomnonom/bades:latest

# ── URL publik ──
SERVER_URL=https://bades.id
FRONTEND_URL=https://bades.id
DEFAULT_SUBDOMAIN=app

# ── Cloudflare (Caddy DNS challenge untuk TLS wildcard) ──
CLOUDFLARE_API_TOKEN=

# ── Secret aplikasi (generate: openssl rand -base64 32) ──
APP_SECRET=
APP_VERSION=0.2.1
ENCRYPTION_KEY=
FALLBACK_ENCRYPTION_KEY=

# ── PostgreSQL (container Docker `db`, sama seperti local) ──
PG_DATABASE_HOST=db
PG_DATABASE_PORT=5432
PG_DATABASE_USER=postgres
PG_DATABASE_PASSWORD=
PG_DATABASE_NAME=default

# ── Redis (container Docker) ──
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=

# ── Multi-tenant ──
NODE_ENV=production
IS_MULTIWORKSPACE_ENABLED=true
IS_WORKSPACE_CREATION_LIMITED_TO_SERVER_ADMINS=false
IS_MANAGED_HOSTING=true
IS_CONFIG_VARIABLES_IN_DB_ENABLED=false
IS_EMAIL_VERIFICATION_REQUIRED=true
IS_BILLING_ENABLED=false
TRUST_PROXY=true

# ── Captcha (nonaktifkan: jangan set CAPTCHA_DRIVER) ──
# CAPTCHA_DRIVER=TURNSTILE
# CAPTCHA_SITE_KEY=
# CAPTCHA_SECRET_KEY=

# ── Storage lokal (volume Docker, sama seperti local) ──
STORAGE_TYPE=local

# ── AI (OpenRouter) ──
OPENROUTER_API_KEY=
AI_MODEL_PREFERENCES=

# ── Mapbox (public token pk.* — diserve via /client-config) ──
MAPBOX_ACCESS_TOKEN=

# ── Email ──
EMAIL_DRIVER=smtp
EMAIL_FROM_ADDRESS=noreply@bades.id
EMAIL_FROM_NAME=Bades
EMAIL_SYSTEM_ADDRESS=noreply@bades.id
EMAIL_SMTP_HOST=smtp.resend.com
EMAIL_SMTP_PORT=465
EMAIL_SMTP_USER=resend
EMAIL_SMTP_PASSWORD=

# ── Logging ──
LOGGER_DRIVER=CONSOLE
LOG_LEVELS=error,warn
EXCEPTION_HANDLER_DRIVER=CONSOLE
TELEMETRY_ENABLED=false
