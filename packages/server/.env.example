# ─────────────────────────────────────────────────────────────────────────────
# Bades.id — Konfigurasi Environment (packages/server/.env)
#
# Copy file ini ke .env sebelum menjalankan server:
#   cp .env.example .env
#
# Semua nilai di bawah adalah default / contoh. Ganti dengan nilai sesungguhnya
# sesuai environment development atau production Anda.
# ─────────────────────────────────────────────────────────────────────────────


# ═══════════════════════════════════════════════════════════════════════════════
# SERVER CONFIG
# ═══════════════════════════════════════════════════════════════════════════════

# Node environment: "development" | "production" | "test"
NODE_ENV=development

# Port yang digunakan server (default 3000)
NODE_PORT=3000

# URL publik server (dipakai untuk generate link di email, callback OAuth, dll)
SERVER_URL=http://localhost:3000

# Secret untuk JWT signing & session encryption. WAJIB diisi.
# Generate dengan: openssl rand -hex 32
APP_SECRET=change-me-to-a-random-secret

# Kunci utama untuk enkripsi at-rest (secret encryption, session cookies).
# Falls back ke APP_SECRET jika tidak diatur.
# ENCRYPTION_KEY=

# Kunci fallback untuk verifikasi saat rotasi ENCRYPTION_KEY.
# Diisi dengan ENCRYPTION_KEY sebelumnya saat rotasi kunci.
# FALLBACK_ENCRYPTION_KEY=

# Setting "trust proxy" Express — kontrol header X-Forwarded-*
TRUST_PROXY=loopback, linklocal, uniquelocal

# Unique identifier untuk server instance ini (di-generate saat DB seed)
# SERVER_ID=

# Aktifkan mode multi-workspace (SaaS) — default Bades.id produksi: true
IS_MULTIWORKSPACE_ENABLED=true

# URL frontend Vite dev server (native dev). Stack Docker GHCR: http://localhost:3000
FRONTEND_URL=http://localhost:3001

# Subdomain default untuk workspace app
DEFAULT_SUBDOMAIN=app

# Managed hosting mode — nonaktifkan auto-grant server admin ke user pertama
# IS_MANAGED_HOSTING=false

# Base URL untuk public domains
# PUBLIC_DOMAIN_URL=

# License key untuk Enterprise version
# ENTERPRISE_KEY=

# Signed enterprise validity token (JWT fallback)
# ENTERPRISE_VALIDITY_TOKEN=

# Base URL untuk Enterprise API bades.id
# ENTERPRISE_API_URL=https://bades.id/api/enterprise

# Auto-rotation interval (hari) untuk JWT signing key
# SIGNING_KEY_ROTATION_DAYS=

# Bades server version (diisi otomatis saat build/deploy)
# APP_VERSION=

# Simpan config variables di database (production=true, dev=false)
IS_CONFIG_VARIABLES_IN_DB_ENABLED=false

# Batasi pembuatan workspace hanya untuk server admin
IS_WORKSPACE_CREATION_LIMITED_TO_SERVER_ADMINS=false

# Token Mapbox public (pk.*) untuk tampilan peta dan autocomplete/geocoding alamat.
# Dikirim ke browser via /client-config saat runtime — tidak perlu di-build
# ke image frontend. Satu token untuk peta + Search Box API (tanpa Google API).
# Dapatkan token gratis di https://account.mapbox.com/access-tokens/
# MAPBOX_ACCESS_TOKEN=pk.your-public-token


# ═══════════════════════════════════════════════════════════════════════════════
# DATABASE
# ═══════════════════════════════════════════════════════════════════════════════

# URL koneksi PostgreSQL utama
PG_DATABASE_URL=postgres://postgres:postgres@localhost:5432/default

# Opsional: URL koneksi PostgreSQL replica (read queries)
# PG_DATABASE_REPLICA_URL=

# Izinkan self-signed SSL certificate (hanya untuk development)
# PG_SSL_ALLOW_SELF_SIGNED=false

# Maksimum koneksi di pg pool
# PG_POOL_MAX_CONNECTIONS=10

# Idle timeout dalam ms untuk pg pool
# PG_POOL_IDLE_TIMEOUT_MS=600000

# Izinkan idle pg pool client untuk exit
# PG_POOL_ALLOW_EXIT_ON_IDLE=true

# Timeout query primary database (ms)
# PG_DATABASE_PRIMARY_TIMEOUT_MS=10000

# Timeout query replica database (ms)
# PG_DATABASE_REPLICA_TIMEOUT_MS=10000

# Timeout ILIKE fallback search query per object (ms)
# SEARCH_ILIKE_FALLBACK_TIMEOUT_MS=2000

# Aktifkan foreign data wrapper (FDW)
# IS_FDW_ENABLED=false

# TypeORM logging: query, schema, error, warn, info, log, migration
TYPEORM_LOGGING=error


# ═══════════════════════════════════════════════════════════════════════════════
# REDIS
# ═══════════════════════════════════════════════════════════════════════════════

# URL koneksi Redis untuk cache & message queue
REDIS_URL=redis://localhost:6379

# Koneksi Redis terpisah untuk queue (opsional, produksi lanjutan)
# REDIS_QUEUE_URL=

# Password autentikasi Redis
# REDIS_PASSWORD=


# ═══════════════════════════════════════════════════════════════════════════════
# STORAGE
# ═══════════════════════════════════════════════════════════════════════════════

# Tipe storage: "local" (default) atau "s3"
STORAGE_TYPE=local

# Local path untuk storage (jika STORAGE_TYPE=local)
STORAGE_LOCAL_PATH=.local-storage

# ── S3 (hanya jika STORAGE_TYPE=s3) ──
# STORAGE_S3_REGION=ap-southeast-1
# STORAGE_S3_NAME=bucket-name
# STORAGE_S3_ENDPOINT=https://s3.ap-southeast-1.amazonaws.com
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=
# STORAGE_S3_PRESIGNED_URL_ENABLED=false
# STORAGE_S3_PRESIGNED_URL_BASE=
# STORAGE_S3_PRESIGNED_URL_EXPIRES_IN=900

# Maksimum ukuran upload tarball aplikasi (bytes)
# MAX_TARBALL_UPLOAD_SIZE_BYTES=104857600


# ═══════════════════════════════════════════════════════════════════════════════
# TOKENS DURATION
# ═══════════════════════════════════════════════════════════════════════════════

# ACCESS_TOKEN_EXPIRES_IN=30m
# REFRESH_TOKEN_EXPIRES_IN=60d
# REFRESH_TOKEN_REUSE_GRACE_PERIOD=1m
# LOGIN_TOKEN_EXPIRES_IN=15m
# FILE_TOKEN_EXPIRES_IN=1d
# INVITATION_TOKEN_EXPIRES_IN=30d
# EMAIL_VERIFICATION_TOKEN_EXPIRES_IN=1h
# PASSWORD_RESET_TOKEN_EXPIRES_IN=5m
# SHORT_TERM_TOKEN_EXPIRES_IN=5m
# WORKSPACE_AGNOSTIC_TOKEN_EXPIRES_IN=30m
# APPLICATION_ACCESS_TOKEN_EXPIRES_IN=30m
# APPLICATION_REFRESH_TOKEN_EXPIRES_IN=60d


# ═══════════════════════════════════════════════════════════════════════════════
# AUTHENTICATION
# ═══════════════════════════════════════════════════════════════════════════════

# Enable/disable password authentication
# AUTH_PASSWORD_ENABLED=true

# Prefill email login form (development)
# SIGN_IN_PREFILLED=false

# Require email verification
# IS_EMAIL_VERIFICATION_REQUIRED=false

# ── Google OAuth ──
# AUTH_GOOGLE_ENABLED=false
# AUTH_GOOGLE_CLIENT_ID=
# AUTH_GOOGLE_CLIENT_SECRET=
# AUTH_GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/redirect
# AUTH_GOOGLE_APIS_CALLBACK_URL=http://localhost:3000/auth/google-apis/get-access-token

# ── Microsoft OAuth ──
# AUTH_MICROSOFT_ENABLED=false
# AUTH_MICROSOFT_CLIENT_ID=
# AUTH_MICROSOFT_CLIENT_SECRET=
# AUTH_MICROSOFT_CALLBACK_URL=http://localhost:3000/auth/microsoft/redirect
# AUTH_MICROSOFT_APIS_CALLBACK_URL=http://localhost:3000/auth/microsoft-apis/get-access-token


# ═══════════════════════════════════════════════════════════════════════════════
# EMAIL
# ═══════════════════════════════════════════════════════════════════════════════

# EMAIL_FROM_ADDRESS=noreply@yourdomain.com
# EMAIL_FROM_NAME=Bades.id
# EMAIL_DRIVER=logger

# ── SMTP (hanya jika EMAIL_DRIVER=smtp) ──
# EMAIL_SMTP_HOST=
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USER=
# EMAIL_SMTP_PASSWORD=
# EMAIL_SMTP_NO_TLS=false


# ═══════════════════════════════════════════════════════════════════════════════
# GOOGLE & MICROSOFT INTEGRATIONS
# ═══════════════════════════════════════════════════════════════════════════════

# Google Calendar
# CALENDAR_PROVIDER_GOOGLE_ENABLED=false

# Gmail messaging
# MESSAGING_PROVIDER_GMAIL_ENABLED=false

# Microsoft Calendar
# CALENDAR_PROVIDER_MICROSOFT_ENABLED=false

# Microsoft messaging
# MESSAGING_PROVIDER_MICROSOFT_ENABLED=false

# IMAP/SMTP/CalDAV
# IS_IMAP_SMTP_CALDAV_ENABLED=true
# IS_IMAP_SMTP_CALDAV_CONNECTION_TEST_ENABLED=true

# Batch size untuk message import
# MESSAGING_MESSAGES_GET_BATCH_SIZE=400


# ═══════════════════════════════════════════════════════════════════════════════
# BILLING
# ═══════════════════════════════════════════════════════════════════════════════

# IS_BILLING_ENABLED=false

# Link halaman paket billing
# BILLING_PLAN_REQUIRED_LINK=https://bades.id/pricing

# Durasi free trial dengan kartu kredit (hari)
# BILLING_FREE_TRIAL_WITH_CREDIT_CARD_DURATION_IN_DAYS=30

# Durasi free trial tanpa kartu kredit (hari)
# BILLING_FREE_TRIAL_WITHOUT_CREDIT_CARD_DURATION_IN_DAYS=7

# Kredit gratis trial — dengan kartu kredit (microCredits)
# BILLING_FREE_WORKFLOW_CREDITS_FOR_TRIAL_PERIOD_WITH_CREDIT_CARD=5000000

# Kredit gratis trial — tanpa kartu kredit (microCredits)
# BILLING_FREE_WORKFLOW_CREDITS_FOR_TRIAL_PERIOD_WITHOUT_CREDIT_CARD=500000

# ── Midtrans ──
# MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxxxxxxxxxx
# MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxxxxxxxxxx
# MIDTRANS_IS_PRODUCTION=false

# Gunakan ClickHouse poller untuk credit cap enforcement
# BILLING_USAGE_CAP_CLICKHOUSE_ENABLED=false


# ═══════════════════════════════════════════════════════════════════════════════
# AI / LLM
# ═══════════════════════════════════════════════════════════════════════════════
#
# Bades AI berjalan dengan satu model: `tencent/hy3-preview` lewat
# OpenRouter (lihat https://openrouter.ai/tencent/hy3-preview/api). Slug
# ini PERSIS seperti di dokumentasi — JANGAN tambahkan suffix tanggal,
# OpenRouter akan mengembalikan 404.
# Konfigurasi `OPENROUTER_API_KEY` (wajib) mengaktifkan provider `openrouter`
# di AiModelRegistryService. Tanpa env ini, provider dianggap tidak
# terkonfigurasi dan chat akan melempar `API_KEY_NOT_CONFIGURED`.
#
# Paket SDK yang dipakai: `@ai-sdk/openai-compatible` (lihat
# packages/server/src/engine/metadata-modules/ai/ai-models/ai-providers.json).
# ═══════════════════════════════════════════════════════════════════════════════

# OpenRouter (satu-satunya provider operasional Bades AI)
OPENROUTER_API_KEY=

# OpenAI (tidak dipakai untuk Bades AI; biarkan kosong kecuali kustom)
# OPENAI_API_KEY=

# Anthropic (Claude) — tidak dipakai
# ANTHROPIC_API_KEY=

# Google AI (Gemini) — tidak dipakai
# GOOGLE_API_KEY=

# xAI (Grok) — tidak dipakai
# XAI_API_KEY=

# Groq — tidak dipakai
# GROQ_API_KEY=

# Mistral — tidak dipakai
# MISTRAL_API_KEY=

# Custom AI providers (JSON) — biarkan kosong untuk single-model setup
# AI_PROVIDERS=

# Model preferences (JSON). Default bila kosong: hanya tencent/hy3-preview.
# Composite ID mengikuti pola `{provider}/{modelName}`.
# AI_MODEL_PREFERENCES='{"recommendedModels":["openrouter/tencent/hy3-preview"],"defaultFastModels":["openrouter/tencent/hy3-preview"],"defaultSmartModels":["openrouter/tencent/hy3-preview"]}'

# Storage path untuk AI catalog override
# AI_CATALOG_STORAGE_PATH=

# Storage path untuk AI model preferences fallback
# AI_MODEL_PREFERENCES_STORAGE_PATH=


# ═══════════════════════════════════════════════════════════════════════════════
# LOGGING & MONITORING
# ═══════════════════════════════════════════════════════════════════════════════

# Buffer log NestJS (mencegah log hilang saat startup)
# LOGGER_IS_BUFFER_ENABLED=true

# Logger driver (hanya "console" untuk saat ini)
# LOGGER_DRIVER=console

# Level logging: log, error, warn, debug
LOG_LEVELS=log,error,warn

# Exception handler driver: "console" | "sentry"
# EXCEPTION_HANDLER_DRIVER=console

# Application log driver: "disabled" | "console" | "clickhouse"
# APPLICATION_LOG_DRIVER=disabled

# Telemetry
# TELEMETRY_ENABLED=false

# ── Sentry ──
# SENTRY_DSN=
# SENTRY_FRONT_DSN=
# SENTRY_ENVIRONMENT=development

# ── OpenTelemetry Metrics ──
# METER_DRIVER=
# OTLP_COLLECTOR_METRICS_ENDPOINT_URL=
# OTLP_COLLECTOR_TRACES_ENDPOINT_URL=


# ═══════════════════════════════════════════════════════════════════════════════
# SUPPORT CHAT
# ═══════════════════════════════════════════════════════════════════════════════

# Support driver: "none" | "front"
# SUPPORT_DRIVER=none

# Front chat integration
# SUPPORT_FRONT_CHAT_ID=
# SUPPORT_FRONT_HMAC_KEY=


# ═══════════════════════════════════════════════════════════════════════════════
# RATE LIMITING
# ═══════════════════════════════════════════════════════════════════════════════

# Short window API rate limiting
# API_RATE_LIMITING_SHORT_TTL_IN_MS=1000
# API_RATE_LIMITING_SHORT_LIMIT=100

# Long window API rate limiting
# API_RATE_LIMITING_LONG_TTL_IN_MS=60000
# API_RATE_LIMITING_LONG_LIMIT=100

# Maksimum records affected by mutations
# MUTATION_MAXIMUM_AFFECTED_RECORDS=100

# GraphQL limits
# GRAPHQL_MAX_FIELDS=2000
# GRAPHQL_MAX_ROOT_RESOLVERS=20
# COMMON_QUERY_COMPLEXITY_LIMIT=2000

# Invitation sending rate limits
# INVITATION_SENDING_BY_WORKSPACE_THROTTLE_TTL_IN_MS=604800000
# INVITATION_SENDING_BY_WORKSPACE_THROTTLE_LIMIT=500
# INVITATION_SENDING_BY_EMAIL_THROTTLE_TTL_IN_MS=604800000
# INVITATION_SENDING_BY_EMAIL_THROTTLE_LIMIT=10

# Workflow execution throttle
# WORKFLOW_EXEC_SOFT_THROTTLE_LIMIT=100
# WORKFLOW_EXEC_SOFT_THROTTLE_TTL=60000
# WORKFLOW_EXEC_HARD_THROTTLE_LIMIT=5000
# WORKFLOW_EXEC_HARD_THROTTLE_TTL=3600000


# ═══════════════════════════════════════════════════════════════════════════════
# SSL
# ═══════════════════════════════════════════════════════════════════════════════

# Path ke SSL key & certificate (untuk HTTPS langsung dari NestJS)
# SSL_KEY_PATH=./certs/your-cert.key
# SSL_CERT_PATH=./certs/your-cert.crt


# ═══════════════════════════════════════════════════════════════════════════════
# CLOUDFLARE
# ═══════════════════════════════════════════════════════════════════════════════

# CLOUDFLARE_API_KEY=
# CLOUDFLARE_ZONE_ID=
# CLOUDFLARE_PUBLIC_DOMAIN_ZONE_ID=
# CLOUDFLARE_WEBHOOK_SECRET=
# CLOUDFLARE_DCV_DELEGATION_ID=


# ═══════════════════════════════════════════════════════════════════════════════
# CODE INTERPRETER
# ═══════════════════════════════════════════════════════════════════════════════

# Driver: "local" (dev) | "e2b" (sandbox) | "disabled"
# CODE_INTERPRETER_TYPE=local

# E2B API key (jika CODE_INTERPRETER_TYPE=e2b)
# E2B_API_KEY=

# Timeout eksekusi kode (ms)
# CODE_INTERPRETER_TIMEOUT_MS=300000


# ═══════════════════════════════════════════════════════════════════════════════
# LOGIC FUNCTION
# ═══════════════════════════════════════════════════════════════════════════════

# Driver: "local" | "lambda" | "disabled"
# LOGIC_FUNCTION_TYPE=local

# Tampilkan console log logic functions di terminal
# LOGIC_FUNCTION_LOGS_ENABLED=false

# Throttle logic function execution
# LOGIC_FUNCTION_EXEC_THROTTLE_LIMIT=1000
# LOGIC_FUNCTION_EXEC_THROTTLE_TTL=60000

# ── AWS Lambda (jika LOGIC_FUNCTION_TYPE=lambda) ──
# LOGIC_FUNCTION_LAMBDA_REGION=
# LOGIC_FUNCTION_LAMBDA_ROLE=
# LOGIC_FUNCTION_LAMBDA_SUBHOSTING_ROLE=
# LOGIC_FUNCTION_LAMBDA_ACCESS_KEY_ID=
# LOGIC_FUNCTION_LAMBDA_SECRET_ACCESS_KEY=
# LOGIC_FUNCTION_LAMBDA_LAYER_BUCKET=
# LOGIC_FUNCTION_LAMBDA_LAYER_BUCKET_REGION=


# ═══════════════════════════════════════════════════════════════════════════════
# ANALYTICS
# ═══════════════════════════════════════════════════════════════════════════════

# ANALYTICS_ENABLED=false

# ClickHouse URL untuk analytics & billing usage tracking
# CLICKHOUSE_URL=http://default:clickhousePassword@localhost:8123/bades


# ═══════════════════════════════════════════════════════════════════════════════
# WORKSPACE MANAGEMENT
# ═══════════════════════════════════════════════════════════════════════════════

# Inactive days sebelum notifikasi
# WORKSPACE_INACTIVE_DAYS_BEFORE_NOTIFICATION=7

# Inactive days sebelum soft delete
# WORKSPACE_INACTIVE_DAYS_BEFORE_SOFT_DELETION=14

# Inactive days sebelum permanent delete
# WORKSPACE_INACTIVE_DAYS_BEFORE_DELETION=21

# Maksimum workspace yang dihapus per eksekusi cron
# MAX_NUMBER_OF_WORKSPACES_DELETED_PER_EXECUTION=5

# Lock workspace schema DDL (untuk hot upgrades)
# WORKSPACE_SCHEMA_DDL_LOCKED=false

# Deprecated — record page layouts selalu di-seed
# SHOULD_SEED_STANDARD_RECORD_PAGE_LAYOUTS=true


# ═══════════════════════════════════════════════════════════════════════════════
# CAPTCHA
# ═══════════════════════════════════════════════════════════════════════════════

# CAPTCHA_DRIVER=
# CAPTCHA_SITE_KEY=
# CAPTCHA_SECRET_KEY=


# ═══════════════════════════════════════════════════════════════════════════════
# MAPS & ADDRESS AUTOCOMPLETE (legacy Google — tidak dipakai)
# ═══════════════════════════════════════════════════════════════════════════════

# Autocomplete alamat memakai MAPBOX_ACCESS_TOKEN (Search Box API).
# Flag Google di bawah hanya legacy, tidak diperlukan untuk Bades SID.
# IS_MAPS_AND_ADDRESS_AUTOCOMPLETE_ENABLED=false
