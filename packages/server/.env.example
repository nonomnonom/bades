# ═══════════════════════════════════════════════════════════════════════════════
# APP REGISTRY
# ═══════════════════════════════════════════════════════════════════════════════

# Default npm registry URL
# APP_REGISTRY_URL=https://registry.npmjs.org

# CDN base URL untuk serving file dari registry
# APP_REGISTRY_CDN_URL=https://unpkg.com

# Auth token untuk private packages
