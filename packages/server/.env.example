# ═══════════════════════════════════════════════════════════════════════════════
# MISCELLANEOUS
# ═══════════════════════════════════════════════════════════════════════════════

# Izinkan request ke favicon service
# ALLOW_REQUESTS_TO_FAVICON_SERVICE=true

# Page ID untuk Cal.com booking integration
# CALENDAR_BOOKING_PAGE_ID=

# TTL cache storage (detik)
# CACHE_STORAGE_TTL=604800

# Enable attachment preview
# IS_ATTACHMENT_PREVIEW_ENABLED=true

# Safe mode untuk outbound HTTP requests
# OUTBOUND_HTTP_SAFE_MODE_ENABLED=true

# Tipe message queue: "bullmq" atau "sync"
# MESSAGE_QUEUE_TYPE=bullmq

# Nonaktifkan DB migrations (untuk worker)
# DISABLE_DB_MIGRATIONS=false

# Nonaktifkan cron jobs (untuk worker)
# DISABLE_CRON_JOBS_REGISTRATION=false

# Health metrics time window (menit)
# HEALTH_METRICS_TIME_WINDOW_IN_MINUTES=5
