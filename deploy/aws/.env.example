# /opt/bades/.env — salin dari packages/server/.env lokal, sesuaikan URL produksi.
TAG=latest
BADES_IMAGE=ghcr.io/nonomnonom/bades

IS_MULTIWORKSPACE_ENABLED=true
IS_WORKSPACE_CREATION_LIMITED_TO_SERVER_ADMINS=false
SIGN_IN_PREFILLED=false
DEFAULT_SUBDOMAIN=app

# URL publik EC2 / domain produksi
SERVER_URL=http://YOUR_EC2_PUBLIC_IP:3000
SERVER_PORT=3000
FRONTEND_URL=http://YOUR_EC2_PUBLIC_IP:3000

# Postgres & Redis internal Docker Compose (jangan pakai localhost)
PG_DATABASE_USER=postgres
PG_DATABASE_PASSWORD=GANTI_PASSWORD_DB
PG_DATABASE_HOST=db
PG_DATABASE_PORT=5432
PG_DATABASE_NAME=default
REDIS_PASSWORD=bades_local_redis

# Salin dari packages/server/.env
ENCRYPTION_KEY=
FALLBACK_ENCRYPTION_KEY=
APP_SECRET=
STORAGE_TYPE=local
OPENROUTER_API_KEY=
AI_MODEL_PREFERENCES={"disabledModels":[],"recommendedModels":["openrouter/tencent/hy3-preview"],"defaultFastModels":["openrouter/tencent/hy3-preview"],"defaultSmartModels":["openrouter/tencent/hy3-preview"]}

# Mapbox: di-bake ke image saat build (bukan runtime). Set secret GitHub
# REACT_APP_MAPBOX_ACCESS_TOKEN + rebuild GHCR, atau build lokal dengan --build-arg.
REACT_APP_MAPBOX_ACCESS_TOKEN=
