{
  "folders": [
    {
      "name": "ROOT",
      "path": "../",
    },
    {
      "name": "packages/front",
      "path": "../packages/front",
    },
    {
      "name": "packages/server",
      "path": "../packages/server",
    },
    {
      "name": "packages/ui",
      "path": "../packages/ui",
    },
    {
      "name": "packages/emails",
      "path": "../packages/emails",
    },
    {
      "name": "packages/shared",
      "path": "../packages/shared",
    },
    {
      "name": "packages/utils",
      "path": "../packages/utils",
    },
    {
      "name": "packages/oxlint-rules",
      "path": "../packages/oxlint-rules",
    },
    {
      "name": "packages/claude-skills",
      "path": "../packages/claude-skills",
    },
    {
      "name": "packages/client-sdk",
      "path": "../packages/client-sdk",
    },
    {
      "name": "packages/front-component-renderer",
      "path": "../packages/front-component-renderer",
    },
    {
      "name": "packages/sdk",
      "path": "../packages/sdk",
    },
  ],
  "settings": {
    "editor.formatOnSave": false,
    "files.eol": "\n",
    "files.insertFinalNewline": true,
    "files.trimTrailingWhitespace": true,
    "[typescript]": {
      "editor.formatOnSave": true,
      "editor.defaultFormatter": "esbenp.prettier-vscode",
      "editor.codeActionsOnSave": {
        "source.fixAll.oxc": "explicit",
        "source.addMissingImports": "always",
        "source.organizeImports": "always",
      },
    },
    "[javascript]": {
      "editor.formatOnSave": true,
      "editor.defaultFormatter": "esbenp.prettier-vscode",
      "editor.codeActionsOnSave": {
        "source.fixAll.oxc": "explicit",
        "source.addMissingImports": "always",
        "source.organizeImports": "always",
      },
    },
    "[typescriptreact]": {
      "editor.formatOnSave": true,
      "editor.defaultFormatter": "esbenp.prettier-vscode",
      "editor.codeActionsOnSave": {
        "source.fixAll.oxc": "explicit",
        "source.addMissingImports": "always",
        "source.organizeImports": "always",
      },
    },
    "[json]": {
      "editor.formatOnSave": true,
    },
    "javascript.format.enable": false,
    "typescript.format.enable": false,
    "cSpell.enableFiletypes": [
      "!javascript",
      "!json",
      "!typescript",
      "!typescriptreact",
      "md",
      "mdx",
    ],
    "cSpell.words": ["badesid"],
    "typescript.preferences.importModuleSpecifier": "non-relative",
    "search.exclude": {
      "**/.yarn": true,
    },
    "files.exclude": {
      "packages/": true,
    },
    "oxc.lint.enable": true,
    "jest.runMode": "on-demand",
    "jest.disabledWorkspaceFolders": ["ROOT", "packages/utils"],
    "files.associations": {
      ".cursorrules": "markdown",
    },
    "jestrunner.codeLensSelector": "**/*.{test,spec,integration-spec}.{js,jsx,ts,tsx}",
    "typescript.tsdk": "node_modules/typescript/lib",
    "typescript.experimental.useTsgo": false,
  },
}
