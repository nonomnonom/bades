# Template .env produksi VPS (1 host + RDS + Redis lokal + Caddy).
# Copy ke VPS: /home/ubuntu/.env
# Jangan commit file .env asli setelah diisi secret.

# ── Image (pin digest yang sehat — jangan pull :latest sembarangan) ──
BADES_IMAGE=ghcr.io/nonomnonom/bades@sha256:PASTE_DIGEST_DISINI

# ── URL publik ──
# WAJIB apex domain — jangan pakai app.bades.id di sini.
# DEFAULT_SUBDOMAIN=app yang membentuk https://app.bades.id otomatis.
SERVER_URL=https://bades.id
FRONTEND_URL=https://bades.id
DEFAULT_SUBDOMAIN=app

# ── Cloudflare (Caddy DNS challenge untuk TLS wildcard) ──
CLOUDFLARE_API_TOKEN=

# ── Secret aplikasi (generate: openssl rand -base64 32) ──
APP_SECRET=
ENCRYPTION_KEY=
FALLBACK_ENCRYPTION_KEY=

# ── RDS PostgreSQL ──
PG_DATABASE_URL=postgres://bades:PASSWORD@bades-db.xxxxx.ap-southeast-3.rds.amazonaws.com:5432/bades?sslmode=require

# ── Redis (service Docker di VPS) ──
REDIS_URL=redis://redis:6379

# ── Multi-tenant ──
NODE_ENV=production
IS_MULTIWORKSPACE_ENABLED=true
IS_WORKSPACE_CREATION_LIMITED_TO_SERVER_ADMINS=false
IS_MANAGED_HOSTING=true
IS_CONFIG_VARIABLES_IN_DB_ENABLED=false
IS_EMAIL_VERIFICATION_REQUIRED=false
IS_BILLING_ENABLED=false
TRUST_PROXY_ENABLED=true
NODE_TLS_REJECT_UNAUTHORIZED=0

# ── Storage S3 ──
STORAGE_TYPE=s3
STORAGE_S3_REGION=ap-southeast-3
STORAGE_S3_NAME=bades-storage-prod

# ── AI (OpenRouter — sama seperti local) ──
OPENROUTER_API_KEY=sk-or-v1-...
AI_MODEL_PREFERENCES={"disabledModels":[],"recommendedModels":["openrouter/tencent/hy3-preview"],"defaultFastModels":["openrouter/tencent/hy3-preview"],"defaultSmartModels":["openrouter/tencent/hy3-preview"]}

# ── Mapbox (public token pk.* — diserve via /client-config) ──
MAPBOX_ACCESS_TOKEN=pk....

# ── Email (Resend / SES / SMTP) ──
EMAIL_DRIVER=smtp
EMAIL_FROM_ADDRESS=noreply@bades.id
EMAIL_FROM_NAME=Bades
EMAIL_SYSTEM_ADDRESS=noreply@bades.id
EMAIL_SMTP_HOST=smtp.resend.com
EMAIL_SMTP_PORT=465
EMAIL_SMTP_USER=resend
EMAIL_SMTP_PASSWORD=

# ── Logging ──
LOGGER_DRIVER=CONSOLE
LOG_LEVELS=error,warn
EXCEPTION_HANDLER_DRIVER=console
TELEMETRY_ENABLED=false
